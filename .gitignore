# This repository is public. Everything is ignored unless it is listed here, so that personal files
# (your configuration, exports, mail, notes) can never be added by accident.
/*
!/.gitignore
!/.dockerignore
!/.github/
!/Dockerfile
!/LICENSE
!/README.md
!/repository.yaml
!/pyproject.toml
!/uv.lock
!/src/
!/starter/
!/mailman/
!/tools/
!/assets/

__pycache__/
*.py[cod]
*.egg-info/
*.zip
*.db
token.json
credentials.json
.env
.DS_Store
